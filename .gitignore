# 데이터 (캐글 API로 받으므로 커밋하지 않음)
data/*
*.csv
*.tsv
*.parquet
*.zip
*.7z

# 모델 / 산출물
output/
models/
*.pkl
*.joblib
*.pt
*.pth
*.bin

# 제출 파일은 기록으로 남긴다 (*.csv 전면 차단의 예외)
!competitions/*/submission*.csv
!competitions/*/submissions/*.csv
!competitions/*/eval/*.csv

# 노트북
.ipynb_checkpoints/
*.nbconvert.ipynb

# 파이썬
__pycache__/
*.py[cod]
.venv/
.venv-*/
venv/
.python-version

# 환경 / 비밀
.env
kaggle.json
.DS_Store

# IDE
.vscode/
.idea/

# 빈 디렉토리 유지
!**/.gitkeep

# 학습 부산물 / 실행 로그
**/catboost_info/
logs.log

# 에디터 로컬 히스토리
.history/
